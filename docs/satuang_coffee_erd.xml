      <attribute name="amount" type="NUMERIC(12,2)" is_pk="false" is_fk="false" nullable="false" description="Nominal dibayarkan"/>
      <attribute name="provider_metadata" type="JSONB" is_pk="false" is_fk="false" nullable="true" description="Payload webhook response Midtrans"/>
      <attribute name="verified_by" type="BIGINT" is_pk="false" is_fk="true" references="users.id" nullable="true" on_delete="SET NULL" description="Kasir yang memverifikasi pembayaran cash"/>
      <attribute name="verified_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Waktu verifikasi pelunasan"/>
      <attribute name="created_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Timestamp dibuat"/>
      <attribute name="updated_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Timestamp diperbarui"/>
    </entity>

    <!-- 15. LOYALTY_RULES -->
    <entity name="loyalty_rules" description="Konfigurasi skema poin loyalitas berversi (Perolehan &amp; Penukaran)">
      <attribute name="id" type="BIGINT" is_pk="true" is_fk="false" nullable="false" auto_increment="true" description="Primary Key"/>
      <attribute name="rule_type" type="VARCHAR(24)" is_pk="false" is_fk="false" nullable="false" description="'earning' | 'redemption'"/>
      <attribute name="version" type="INTEGER" is_pk="false" is_fk="false" nullable="false" description="Nomor versi aturan skema"/>
      <attribute name="name" type="VARCHAR(160)" is_pk="false" is_fk="false" nullable="false" description="Label nama aturan"/>
      <attribute name="configuration" type="JSONB" is_pk="false" is_fk="false" nullable="false" description="Aturan angka (threshold, point_value, min, max_pct)"/>
      <attribute name="is_active" type="BOOLEAN" is_pk="false" is_fk="false" nullable="false" default="false" description="Status aturan yang sedang aktif"/>
      <attribute name="starts_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Mulai berlaku skema"/>
      <attribute name="ends_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Berakhir skema"/>
      <attribute name="created_by" type="BIGINT" is_pk="false" is_fk="true" references="users.id" nullable="true" on_delete="SET NULL" description="Admin pembuat aturan"/>
      <attribute name="created_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Timestamp dibuat"/>
      <attribute name="updated_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Timestamp diperbarui"/>
    </entity>

    <!-- 16. LOYALTY_LEDGER_ENTRIES -->
    <entity name="loyalty_ledger_entries" description="Buku besar mutasi poin member (Immutable ledger)">
      <attribute name="id" type="BIGINT" is_pk="true" is_fk="false" nullable="false" auto_increment="true" description="Primary Key"/>
      <attribute name="member_id" type="BIGINT" is_pk="false" is_fk="true" references="customers.id" nullable="false" on_delete="CASCADE" description="ID Member penerima/pengguna poin"/>
      <attribute name="order_id" type="BIGINT" is_pk="false" is_fk="true" references="orders.id" nullable="true" on_delete="SET NULL" description="ID Pesanan terkait transaksi"/>
      <attribute name="loyalty_rule_id" type="BIGINT" is_pk="false" is_fk="true" references="loyalty_rules.id" nullable="true" on_delete="SET NULL" description="ID Aturan poin yang digunakan"/>
      <attribute name="entry_type" type="VARCHAR(24)" is_pk="false" is_fk="false" nullable="false" description="'earn'|'redeem'|'refund'|'adjustment'|'expire'"/>
      <attribute name="points_delta" type="INTEGER" is_pk="false" is_fk="false" nullable="false" description="Delta mutasi (positif atau negatif)"/>
      <attribute name="rule_snapshot" type="JSONB" is_pk="false" is_fk="false" nullable="true" description="Snapshot aturan saat transaksi"/>
      <attribute name="idempotency_key" type="VARCHAR(120)" is_pk="false" is_fk="false" nullable="true" is_unique="true" description="Kunci pencegah double earn/redeem"/>
      <attribute name="reason" type="TEXT" is_pk="false" is_fk="false" nullable="true" description="Keterangan mutasi poin"/>
      <attribute name="actor_id" type="BIGINT" is_pk="false" is_fk="true" references="users.id" nullable="true" on_delete="SET NULL" description="Staf penyesuai poin manual"/>
      <attribute name="reverses_entry_id" type="BIGINT" is_pk="false" is_fk="true" references="loyalty_ledger_entries.id" nullable="true" on_delete="SET NULL" description="Self-ref ID entri yang dibalik/dikoreksi"/>
      <attribute name="expires_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Masa kadaluarsa poin"/>
      <attribute name="created_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="false" description="Waktu mutasi poin tercatat"/>
    </entity>

    <!-- 17. PRINT_JOBS -->
    <entity name="print_jobs" description="Antrean cetak struk kasir &amp; Kitchen Order Ticket (KOT)">
      <attribute name="id" type="BIGINT" is_pk="true" is_fk="false" nullable="false" auto_increment="true" description="Primary Key"/>
      <attribute name="order_id" type="BIGINT" is_pk="false" is_fk="true" references="orders.id" nullable="false" on_delete="CASCADE" description="ID Pesanan yang dicetak"/>
      <attribute name="retry_of_id" type="BIGINT" is_pk="false" is_fk="true" references="print_jobs.id" nullable="true" on_delete="SET NULL" description="Self-ref ID job asal jika cetak ulang"/>
      <attribute name="document_type" type="VARCHAR(16)" is_pk="false" is_fk="false" nullable="false" description="'invoice' | 'kot'"/>
      <attribute name="destination" type="VARCHAR(80)" is_pk="false" is_fk="false" nullable="true" description="'cashier_thermal' | 'kitchen_bar'"/>
      <attribute name="status" type="VARCHAR(24)" is_pk="false" is_fk="false" nullable="false" default="'MENUNGGU'" description="'MENUNGGU' | 'SUKSES' | 'GAGAL'"/>
      <attribute name="attempt_count" type="SMALLINT" is_pk="false" is_fk="false" nullable="false" default="0" description="Jumlah percobaan cetak"/>
      <attribute name="last_error" type="TEXT" is_pk="false" is_fk="false" nullable="true" description="Pesan error printer"/>
      <attribute name="printed_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Waktu cetak berhasil"/>
      <attribute name="created_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Timestamp dibuat"/>
      <attribute name="updated_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="true" description="Timestamp diperbarui"/>
    </entity>

    <!-- 18. AUDIT_LOGS -->
    <entity name="audit_logs" description="Audit trail pencatatan perubahan data sensitif backoffice">
      <attribute name="id" type="BIGINT" is_pk="true" is_fk="false" nullable="false" auto_increment="true" description="Primary Key"/>
      <attribute name="actor_id" type="BIGINT" is_pk="false" is_fk="true" references="users.id" nullable="true" on_delete="SET NULL" description="ID Staf pelaku perubahan"/>
      <attribute name="action" type="VARCHAR(100)" is_pk="false" is_fk="false" nullable="false" description="Nama aksi (cth: update_loyalty_settings)"/>
      <attribute name="subject_type" type="VARCHAR(100)" is_pk="false" is_fk="false" nullable="true" description="Nama model/entitas sasaran"/>
      <attribute name="subject_id" type="VARCHAR(100)" is_pk="false" is_fk="false" nullable="true" description="ID entitas sasaran"/>
      <attribute name="before_snapshot" type="JSONB" is_pk="false" is_fk="false" nullable="true" description="Snapshot data sebelum perubahan"/>
      <attribute name="after_snapshot" type="JSONB" is_pk="false" is_fk="false" nullable="true" description="Snapshot data sesudah perubahan"/>
      <attribute name="ip_address" type="VARCHAR(45)" is_pk="false" is_fk="false" nullable="true" description="Alamat IP pelaku"/>
      <attribute name="created_at" type="TIMESTAMPTZ" is_pk="false" is_fk="false" nullable="false" description="Waktu pencatatan log"/>
    </entity>
  </entities>

  <!-- RELATIONSHIPS & CARDINALITIES (Crow's Foot Notation) -->
  <relationships>
    <relation name="user_permissions_user" from="users" to="user_permissions" type="1:N" cardinality="1 to 0..*" from_key="id" to_key="user_id" on_delete="CASCADE"/>
    <relation name="user_permissions_permission" from="permissions" to="user_permissions" type="1:N" cardinality="1 to 0..*" from_key="id" to_key="permission_id" on_delete="CASCADE"/>
    <relation name="user_permissions_granter" from="users" to="user_permissions" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="granted_by" on_delete="SET NULL"/>

    <relation name="category_self_hierarchy" from="categories" to="categories" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="parent_id" on_delete="SET NULL" description="Sub-kategori hierarki"/>
    <relation name="category_products" from="categories" to="products" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="category_id" on_delete="SET NULL"/>
    <relation name="category_bundles" from="categories" to="bundles" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="category_id" on_delete="SET NULL"/>

    <relation name="bundle_components_bundle" from="bundles" to="bundle_components" type="1:N" cardinality="1 to 1..*" from_key="id" to_key="bundle_id" on_delete="CASCADE"/>
    <relation name="bundle_components_product" from="products" to="bundle_components" type="1:N" cardinality="1 to 0..*" from_key="id" to_key="product_id" on_delete="RESTRICT"/>

    <relation name="customer_orders" from="customers" to="orders" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="customer_id" on_delete="SET NULL" description="Pesanan oleh member"/>
    <relation name="staff_orders" from="users" to="orders" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="user_id" on_delete="SET NULL" description="Pesanan dicatat kasir"/>

    <relation name="order_items_order" from="orders" to="order_items" type="1:N" cardinality="1 to 1..*" from_key="id" to_key="order_id" on_delete="CASCADE"/>
    <relation name="order_items_product" from="products" to="order_items" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="product_id" on_delete="SET NULL"/>
    <relation name="order_items_bundle" from="bundles" to="order_items" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="bundle_id" on_delete="SET NULL"/>

    <relation name="order_payments" from="orders" to="payments" type="1:N" cardinality="1 to 1..*" from_key="id" to_key="order_id" on_delete="CASCADE"/>
    <relation name="staff_payment_verification" from="users" to="payments" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="verified_by" on_delete="SET NULL"/>

    <relation name="order_status_history_order" from="orders" to="order_status_histories" type="1:N" cardinality="1 to 1..*" from_key="id" to_key="order_id" on_delete="CASCADE"/>
    <relation name="order_status_history_staff" from="users" to="order_status_histories" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="actor_id" on_delete="SET NULL"/>

    <relation name="loyalty_rule_creator" from="users" to="loyalty_rules" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="created_by" on_delete="SET NULL"/>
    <relation name="customer_loyalty_ledger" from="customers" to="loyalty_ledger_entries" type="1:N" cardinality="1 to 0..*" from_key="id" to_key="member_id" on_delete="CASCADE"/>
    <relation name="order_loyalty_ledger" from="orders" to="loyalty_ledger_entries" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="order_id" on_delete="SET NULL"/>
    <relation name="loyalty_rule_ledger" from="loyalty_rules" to="loyalty_ledger_entries" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="loyalty_rule_id" on_delete="SET NULL"/>
    <relation name="loyalty_ledger_reversal" from="loyalty_ledger_entries" to="loyalty_ledger_entries" type="1:N" cardinality="0..1 to 0..1" from_key="id" to_key="reverses_entry_id" on_delete="SET NULL" description="Audit pembatalan poin"/>
    <relation name="loyalty_ledger_actor" from="users" to="loyalty_ledger_entries" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="actor_id" on_delete="SET NULL"/>

    <relation name="order_print_jobs" from="orders" to="print_jobs" type="1:N" cardinality="1 to 0..*" from_key="id" to_key="order_id" on_delete="CASCADE"/>
    <relation name="print_job_retry" from="print_jobs" to="print_jobs" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="retry_of_id" on_delete="SET NULL" description="Retry print job"/>

    <relation name="audit_logs_actor" from="users" to="audit_logs" type="1:N" cardinality="0..1 to 0..*" from_key="id" to_key="actor_id" on_delete="SET NULL"/>
  </relationships>

</database_schema>

